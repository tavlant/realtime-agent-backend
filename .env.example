# Copy to .env and adjust. Every setting has a sensible default; see
# src/agent_backend/config.py for the full list.

# --- storage ---------------------------------------------------------------
# Postgres (with pgvector) is the source of truth. For a zero-infrastructure local run
# use: DATABASE_URL=sqlite+aiosqlite:///./dev.db  and  REDIS_URL=memory://
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0

# --- LLM -------------------------------------------------------------------
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set,
# else the offline, deterministic FakeLLM.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACKS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=16000
# Slow the FakeLLM down to make streaming visible (milliseconds per token).
FAKE_LLM_TOKEN_DELAY_MS=0

# --- reliability -----------------------------------------------------------
LLM_FIRST_TOKEN_TIMEOUT_S=30
LLM_IDLE_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3
TOOL_TIMEOUT_S=10
MAX_TOOL_ROUNDS=5

# --- memory ----------------------------------------------------------------
HOT_STATE_TTL_S=3600
CONTEXT_TOKEN_BUDGET=3000
MIN_RECENT_MESSAGES=4
LOCK_TTL_S=30
LOCK_WAIT_TIMEOUT_S=20

# --- RAG -------------------------------------------------------------------
# auto = pgvector when DATABASE_URL is Postgres, else in-memory.
VECTOR_STORE=auto
# hashing = offline lexical embeddings; openai = text-embedding-3-small (needs a key).
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=256

# --- observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
